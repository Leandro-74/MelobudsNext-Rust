# Maintainer: MelobudsNext contributors
pkgname=melobudsnext
pkgver=0.2.0
pkgrel=1
pkgdesc='Controle do QCY Melobuds Pro via Bluetooth Low Energy'
arch=('x86_64' 'aarch64')
url='https://github.com/Leandro-74/MelobudsNext-Rust'
license=('MIT')
depends=('dbus' 'bluez' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'rust' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e950444f9ffdab3d94350aa20108484ca6a7b352e04177b30071e4d54887e791')

prepare() {
  cd "$srcdir"

  # A tag do GitHub extrai como <repositório>-<versão> (sem o "v" inicial); o
  # tarball gerado por `git archive` (build-local.sh) usa o nome do pacote.
  # Normaliza os dois formatos para o mesmo diretório.
  if [[ ! -d "$pkgname-$pkgver" ]]; then
    mv "MelobudsNext-Rust-$pkgver" "$pkgname-$pkgver"
  fi
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --all-targets --locked
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/melobudsnext "$pkgdir/usr/bin/melobudsnext"
  install -Dm755 target/release/melobudsnext-gui "$pkgdir/usr/bin/melobudsnext-gui"
  install -Dm644 packaging/melobudsnext.desktop \
    "$pkgdir/usr/share/applications/melobudsnext.desktop"
  install -Dm644 assets/logo.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/melobudsnext.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 PROTOCOLO_MelobudsNext.md \
    "$pkgdir/usr/share/doc/$pkgname/PROTOCOLO_MelobudsNext.md"
}
